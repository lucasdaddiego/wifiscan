# Build artifacts, never committed: the app bundle is assembled under .build/ and installed
# into ~/Applications; /wifiscan is where older Makefiles put a bare binary
/wifiscan
*.app
.build/
_CodeSignature/
*.dSYM/

# Machine-local Make overrides (e.g. a personal code-signing identity)
Makefile.local

# Editor / local agent config
.claude/
